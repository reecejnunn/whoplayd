{
  "name": "whoplayd",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx --ignore-pattern 'node_modules' --ignore-pattern '.expo'",
    "format-check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit --project tsconfig.base.json",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "~6.0.3"
  }
}
